PORT=3000
HOST=0.0.0.0
# SQLite for local development; Docker Compose supplies PostgreSQL.
DATABASE_URL=
SQLITE_PATH=data/pulse.db
REDIS_URL=
ELASTICSEARCH_URL=
PUBLIC_ORIGIN=
COOKIE_SECURE=false
TRUST_PROXY=false
# Allowed writes per minute per user. Increase for the classroom load test.
MESSAGE_RATE_LIMIT=120
# Desktop/mobile wrappers connect to this same-origin server.
CHAT_URL=http://localhost:3000

# Required for Docker Compose; use a long random value.
POSTGRES_PASSWORD=

BIND_IP=0.0.0.0
